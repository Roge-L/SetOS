# Local secrets for `wrangler dev`. Copy to `.dev.vars` and fill in.
# In production these are set with `npx wrangler secret put <NAME>` instead.
#
# Non-secret config (SUPABASE_URL, SETOS_USER_ID, SETOS_TIMEZONE) lives in
# wrangler.jsonc `vars`, so it is NOT needed here.

# Approves a connection on the OAuth consent screen. Long + random:
#   openssl rand -hex 24
SETOS_CONSENT_PASSPHRASE=

# Supabase service-role key (server-side, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# FatSecret (optional — only setos_lookup_food uses it). https://platform.fatsecret.com
FATSECRET_ID=
FATSECRET_SECRET=
