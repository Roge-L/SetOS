# Local secrets for `wrangler dev`. Copy to `.dev.vars` and fill in.
# In production these are set with `npx wrangler secret put <NAME>` instead.
#
# Non-secret config (SUPABASE_URL, SUPABASE_ANON_KEY) lives in wrangler.jsonc
# `vars`, so it is NOT needed here.

# --- Sign-in ----------------------------------------------------------------
# HMAC key for the signed blob that carries the in-flight authorization request
# between the sign-in form and its submission.
# Any long random string:  openssl rand -hex 32
SETOS_STATE_SECRET=

# --- Supabase ---------------------------------------------------------------
# EC P-256 private key as a single-line JWK, e.g.
#   {"kty":"EC","kid":"<uuid>","d":"...","crv":"P-256","x":"...","y":"..."}
# Signs the short-lived per-user token that makes auth.uid() resolve, which is
# what arms the RLS policies. Without it every request fails closed.
#
# Generate with `supabase gen signing-key --algorithm ES256`, then import it at
# Dashboard -> Settings -> JWT Keys as a STANDBY key. Do NOT rotate to it: that
# would make this key sign every user session in the project, when all we need
# is for Supabase to verify tokens we mint. Standby keys are published in the
# JWKS, which is enough for verification.
SUPABASE_SIGNING_KEY=

# Service-role key. Bypasses RLS; used ONLY to look up the invitation row right
# after a password checks out. Never reaches a tool handler.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---------------------------------------------------------------
# FatSecret (only setos_lookup_food uses it). https://platform.fatsecret.com
FATSECRET_ID=
FATSECRET_SECRET=
